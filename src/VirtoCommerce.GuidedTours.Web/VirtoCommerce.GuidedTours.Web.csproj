<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <Compile Remove="ShellPlugin\**" />
    <Content Remove="ShellPlugin\**" />
    <EmbeddedResource Remove="ShellPlugin\**" />
    <None Remove="ShellPlugin\**" />
    <Compile Remove="App\**" />
    <Content Remove="App\**" />
    <EmbeddedResource Remove="App\**" />
    <None Remove="App\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Localizations\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.GuidedTours.Core\VirtoCommerce.GuidedTours.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.GuidedTours.Data\VirtoCommerce.GuidedTours.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.GuidedTours.Data.MySql\VirtoCommerce.GuidedTours.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.GuidedTours.Data.PostgreSql\VirtoCommerce.GuidedTours.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.GuidedTours.Data.SqlServer\VirtoCommerce.GuidedTours.Data.SqlServer.csproj" />
  </ItemGroup>
</Project>

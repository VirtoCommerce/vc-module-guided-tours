{
  "name": "vc-guided-tours-plugin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "serve": "cross-env APP_ENV=development vite --force",
    "build": "cross-env APP_ENV=production vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "build:admin-shell": "cross-env APP_ENV=production vite build --config vite.admin-shell.config.mts"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@vc-shell/mf-module": "^2.11.0",
    "@vc-shell/ts-config": "^2.11.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "sass": "^1.87.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "3.2.7",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "@vc-shell/config-generator": "^2.11.0",
    "@vc-shell/framework": "^2.11.0",
    "driver.js": "1.4.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "packageManager": "yarn@4.9.1"
}

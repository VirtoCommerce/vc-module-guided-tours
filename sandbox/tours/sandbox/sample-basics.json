{
  "id": "sample.basics",
  "version": 1,
  "title": {
    "en-US": "Products: search and bulk actions"
  },
  "publishedAt": "2026-11-11",
  "trigger": {
    "bladeOpened": "SampleList"
  },
  "steps": [
    {
      "title": {
        "en-US": "New in Products"
      },
      "text": {
        "en-US": "Find products by name and change several at once. Let's try it — it takes half a minute."
      }
    },
    {
      "target": {
        "css": "[data-tour='sample.table'] .vc-input",
        "label": "search field"
      },
      "title": {
        "en-US": "Find it fast"
      },
      "text": {
        "en-US": "Type “desk” to search the catalog by name."
      },
      "placement": "bottom",
      "action": {
        "until": {
          "bladeQueryChanged": "SampleList"
        }
      }
    },
    {
      "target": {
        "css": "[data-tour='sample.table'] .vc-data-table__rows-container",
        "label": "product rows"
      },
      "title": {
        "en-US": "Pick several"
      },
      "text": {
        "en-US": "Tick both desks."
      },
      "placement": "bottom",
      "action": {
        "until": {
          "elementAppears": {
            "css": "[data-tour='sample.table'] .vc-data-table__rows-container input:checked",
            "label": "ticked product checkboxes"
          },
          "atLeast": 2
        }
      }
    },
    {
      "target": {
        "css": "[data-test-id='discount']",
        "label": "10% off button"
      },
      "title": {
        "en-US": "Bulk actions"
      },
      "text": {
        "en-US": "Toolbar actions now apply to every selected product. Cut both sale prices by 10% in one click."
      },
      "placement": "bottom",
      "action": {
        "until": {
          "click": true
        }
      }
    },
    {
      "target": {
        "css": "[data-tour='sample.table'] .vc-data-table__rows-container",
        "label": "product rows"
      },
      "title": {
        "en-US": "Done"
      },
      "text": {
        "en-US": "Both prices changed at once — one click instead of editing each product."
      },
      "placement": "bottom"
    }
  ]
}
